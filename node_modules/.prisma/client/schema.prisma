generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Usuario {
  id       Int      @id @default(autoincrement())
  nome     String
  email    String   @unique
  senha    String
  tipo     String   @default("operador")
  criadoEm DateTime @default(now())

  contatos  Contato[]
  followups Followup[]
}

model Contato {
  id         Int      @id @default(autoincrement())
  nome       String
  telefone   String
  email      String?
  observacao String?
  criadoEm   DateTime @default(now())
  usuario_id Int?
  usuario    Usuario? @relation(fields: [usuario_id], references: [id])

  whatsapps Whatsapp[]
  followups Followup[]
}

model Ura {
  id       Int      @id @default(autoincrement())
  nome     String
  mensagem String?
  destino  String?
  dtmf     String?
  audioUrl String?
  ativo    Boolean  @default(true)
  criadoEm DateTime @default(now())
}

model Whatsapp {
  id         Int      @id @default(autoincrement())
  contato_id Int
  contato    Contato  @relation(fields: [contato_id], references: [id])
  mensagem   String
  status     String   @default("enviado")
  criadoEm   DateTime @default(now())
}

model Followup {
  id         Int      @id @default(autoincrement())
  contato_id Int
  contato    Contato  @relation(fields: [contato_id], references: [id])
  usuario_id Int?
  usuario    Usuario? @relation(fields: [usuario_id], references: [id])
  tipo       String?
  data       DateTime @default(now())
  observacao String?
  criadoEm   DateTime @default(now())
}

model Chamada {
  id         Int      @id @default(autoincrement())
  contato_id Int?
  origem     String?
  destino    String?
  duracao    Int?
  status     String?
  criadoEm   DateTime @default(now())
}

model Configuracao {
  id       Int     @id @default(autoincrement())
  tema     String?
  audioUra String?
}
